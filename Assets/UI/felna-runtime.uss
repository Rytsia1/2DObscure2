/* Shared runtime styles for FELNA Figma UI Toolkit screens.
   Follows strict Unity USS subset (no gap, border shorthand, z-index, or box-shadow). */

.uitk-screen-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

Label,
Button,
.unity-text-element,
.unity-label,
.unity-button {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaUIFont.asset");
}

.button-flat-2 {
    -unity-text-align: middle-left;
}

.section-header {
    width: auto;
    height: auto;
    min-height: 34px;
    overflow: visible;
    align-self: stretch;
}

.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e {
    overflow: visible;
}

.uitk-hidden {
    display: none;
}

.uitk-cursor-hidden {
    visibility: hidden;
}

.uitk-cursor-visible {
    visibility: visible;
}

.uitk-disabled {
    opacity: 0.45;
}

/* Interactive flat navigation rows (e.g. Main Menu, Settings category, Hub facilities) */
.uitk-flat-item {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-right: 16px;
    padding-bottom: 6px;
    padding-left: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.uitk-flat-item:hover {
    background-color: rgba(122, 87, 23, 0.35);
}

.uitk-flat-item.uitk-focus {
    background-color: var(--accent-focus-wash);
}

.uitk-flat-item.uitk-selected {
    border-width: 1px;
    border-color: var(--gold-3);
    background-color: rgba(242, 194, 91, 0.12);
}

.uitk-flat-cursor {
    width: 18px;
    color: var(--text-highlight);
    font-size: 20px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.uitk-flat-label {
    color: var(--text-primary);
    font-size: 20px;
    white-space: nowrap;
    flex-grow: 1;
}

.uitk-flat-item.uitk-focus > .uitk-flat-label,
.uitk-flat-item.uitk-selected > .uitk-flat-label {
    color: var(--text-highlight);
}

.uitk-flat-item.uitk-disabled > .uitk-flat-label {
    color: var(--text-muted);
}

.uitk-flat-sub {
    color: var(--text-body);
    font-size: 13px;
    letter-spacing: 0.4px;
    white-space: nowrap;
}

/* Figma template button focus/unfocus overrides */
.button-flat-2:hover {
    background-color: rgba(122, 87, 23, 0.35);
    color: var(--text-highlight);
}

.button-flat-2.uitk-focus {
    background-color: var(--accent-focus-wash);
    color: var(--text-highlight);
}

.button-slab:hover {
    background-color: var(--bg-raised);
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.button-slab.uitk-focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.button-primary:hover {
    background-color: var(--text-highlight);
    border-color: var(--text-highlight);
}

.button-primary.uitk-focus {
    background-color: var(--text-highlight);
    border-color: var(--text-highlight);
}

.button-primary > Label {
    color: var(--text-on-accent);
}

.button-slab > Label {
    color: var(--text-primary);
}

.button-slab:hover > Label,
.button-slab.uitk-focus > Label {
    color: var(--text-highlight);
}

.button-danger {
    padding-top: 6px;
    padding-right: 20px;
    padding-bottom: 6px;
    padding-left: 20px;
    border-width: 2px;
    border-color: var(--vital-hp-low);
    background-color: rgba(40, 14, 18, 1);
    color: var(--vital-hp-low);
    font-size: 20px;
    white-space: nowrap;
    justify-content: center;
    align-items: center;
}

.button-danger:hover,
.button-danger.uitk-focus {
    background-color: rgba(180, 44, 34, 1);
    color: var(--text-primary);
    border-color: var(--text-highlight);
}

.button-flat.uitk-unfocused {
    background-color: rgba(0, 0, 0, 0);
}

.button-flat.uitk-unfocused > .button-flat__e {
    visibility: hidden;
}

.button-flat.uitk-unfocused > .button-flat__e-2 {
    color: var(--text-primary);
}

.button-primary-2.uitk-unfocused {
    background-color: var(--accent-gold);
    border-color: var(--border-focus);
}

.button-primary-2.uitk-unfocused > .button-primary-2__e {
    visibility: hidden;
}

.button-slab-2.uitk-unfocused {
    background-color: var(--bg-panel);
    border-color: var(--border-default);
}

.button-slab-2.uitk-unfocused > .button-slab-2__e {
    visibility: hidden;
}

.button-slab-2.uitk-unfocused > .button-slab-2__e-2 {
    color: var(--text-primary);
}

/* Slot Cards (Load / Save) */
.uitk-slot-interactive {
    border-width: 2px;
    border-color: var(--border-line);
    background-color: var(--bg-panel);
}

.uitk-slot-interactive:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-raised);
}

.uitk-slot-interactive.uitk-selected,
.uitk-slot-interactive.uitk-focus {
    border-color: var(--border-accent);
    background-color: var(--bg-raised);
}

/* Selectable Cards (Character Creation Race / Class / Background / Gear / Party) */
.uitk-card {
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-line);
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 6px;
    padding-left: 10px;
    margin-bottom: 6px;
}

.uitk-card:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-raised);
}

.uitk-card.uitk-selected,
.uitk-card.uitk-focus {
    border-color: var(--border-accent);
    background-color: var(--bg-raised);
}

.uitk-card-title {
    font-size: 18px;
    color: var(--text-primary);
    white-space: nowrap;
}

.uitk-card.uitk-selected .uitk-card-title,
.uitk-card.uitk-focus .uitk-card-title {
    color: var(--text-highlight);
}

.uitk-card-sub {
    font-size: 12px;
    letter-spacing: 0.48px;
    color: var(--text-muted);
    white-space: normal;
}

/* Badges & Tags */
.uitk-badge-gold {
    background-color: rgba(43, 34, 16, 1);
    border-width: 1px;
    border-color: var(--border-focus);
    color: var(--text-highlight);
    padding-top: 2px;
    padding-right: 8px;
    padding-bottom: 2px;
    padding-left: 8px;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
}

.uitk-badge-ok {
    background-color: rgba(14, 40, 24, 1);
    border-width: 1px;
    border-color: var(--vital-hp);
    color: var(--vital-hp);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

.uitk-badge-err {
    background-color: rgba(40, 14, 18, 1);
    border-width: 1px;
    border-color: var(--vital-hp-low);
    color: var(--vital-hp-low);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

/* Settings Interactive Controls */
.uitk-settings-row {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: var(--border-line);
    padding-right: 12px;
    padding-left: 12px;
}

.uitk-settings-row.uitk-focus {
    background-color: rgba(242, 194, 91, 0.08);
}

.uitk-dirty-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-gold);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-dirty-dot-off {
    width: 8px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-seg-wrap {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-width: 2px;
    border-color: var(--border-default);
    background-color: var(--bg-void);
}

.uitk-seg-wrap.uitk-focus {
    border-color: var(--text-highlight);
}

.uitk-seg-opt {
    padding-top: 3px;
    padding-right: 12px;
    padding-bottom: 3px;
    padding-left: 12px;
    margin-right: 4px;
    font-size: 16px;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    white-space: nowrap;
}

.uitk-seg-opt.uitk-selected {
    background-color: var(--accent-gold);
    color: var(--text-on-accent);
}

/* Modal Backdrop & Dialog */
.uitk-modal-backdrop {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(4, 6, 12, 0.88);
    align-items: center;
    justify-content: center;
}

.uitk-modal-panel {
    width: 640px;
    padding-top: 22px;
    padding-right: 26px;
    padding-bottom: 22px;
    padding-left: 26px;
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-accent);
}

.uitk-modal-title {
    font-size: 24px;
    color: var(--text-highlight);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.uitk-modal-divider {
    height: 2px;
    background-color: var(--border-focus);
    margin-bottom: 16px;
}

.uitk-modal-message {
    font-size: 18px;
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: 24px;
}

.uitk-modal-buttons {
    flex-direction: row;
    justify-content: center;
}

.uitk-modal-btn {
    width: 200px;
    margin-right: 16px;
    margin-left: 16px;
}

/* Fade Overlay */
.uitk-fade-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: var(--bg-void);
}
