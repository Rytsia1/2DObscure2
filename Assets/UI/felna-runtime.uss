/* Shared runtime styles for FELNA Figma UI Toolkit screens.
   Follows strict Unity USS subset (no gap, border shorthand, z-index, or box-shadow). */

.uitk-screen-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    justify-content: center;
    align-items: center;
    background-color: #090C14;
}

Label,
.unity-text-element,
.unity-label,
.uitk-font-ui {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaUIFont.asset");
}

/* Display Serif (Cinzel Bold) — Titles, Screen Headers, Modals, Prologue */
.uitk-font-display,
.felna-vars,
.victory-vars,
.dungeon-clear-vars,
.uitk-opening-title,
.uitk-modal-title,
.settings-vars,
.create-character-vars,
.load-game-vars,
.geistwald-city-vars,
.party-vars,
.shop-vars-2,
.armory-vars-2,
.blacksmith-vars-2,
.temple-vars-2,
.magic-shop-vars-2,
.save-game-vars,
.the-sunken-crypt-vars,
.status-vars,
.inventory-vars-2,
.equipment-vars-4,
.training-ground-vars-2,
.talents-vars,
.wandering-merchant-vars,
.the-sunken-crypt-vars-3,
.the-sunken-crypt-vars-4,
.create-character-vars-2,
.victory-vars-2,
.zoroa-harvester-of-souls-vars {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaDisplayFont.asset");
}

/* Pixel Gothic (DotGothic16) — Section Headers, Buttons, Menu Rows, Card Titles, Tabs */
.uitk-font-gothic,
Button,
.unity-button,
.unity-button > .unity-label,
.button-flat,
.button-flat-2,
.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2,
.button-slab,
.button-slab-2,
.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2,
.button-primary,
.button-primary-2,
.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2,
.button-danger,
.section-header,
.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3,
.uitk-card-title,
.uitk-flat-label,
.uitk-tab-btn,
.uitk-opening-name {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaGothicFont.asset");
}

.button-flat-2 {
    -unity-text-align: middle-left;
}

.section-header {
    width: auto;
    height: auto;
    min-height: 34px;
    overflow: visible;
    align-self: stretch;
}

.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e {
    overflow: visible;
}

.uitk-hidden {
    display: none;
}

.uitk-cursor-hidden {
    visibility: hidden;
}

.uitk-cursor-visible {
    visibility: visible;
}

.uitk-disabled {
    opacity: 0.45;
}

/* Interactive flat navigation rows (e.g. Main Menu, Settings category, Hub facilities) */
.uitk-flat-item {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-right: 16px;
    padding-bottom: 6px;
    padding-left: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.uitk-flat-item:hover {
    background-color: rgba(122, 87, 23, 0.35);
}

.uitk-flat-item.uitk-focus {
    background-color: var(--accent-focus-wash);
}

.uitk-flat-item.uitk-selected {
    border-width: 1px;
    border-color: var(--gold-3);
    background-color: rgba(242, 194, 91, 0.12);
}

.uitk-flat-cursor {
    width: 18px;
    color: var(--text-highlight);
    font-size: 20px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.uitk-flat-label {
    color: var(--text-primary);
    font-size: 20px;
    white-space: nowrap;
    flex-grow: 1;
}

.uitk-flat-item.uitk-focus > .uitk-flat-label,
.uitk-flat-item.uitk-selected > .uitk-flat-label {
    color: var(--text-highlight);
}

.uitk-flat-item.uitk-disabled > .uitk-flat-label {
    color: var(--text-muted);
}

.uitk-flat-sub {
    color: var(--text-body);
    font-size: 13px;
    letter-spacing: 0.4px;
    white-space: nowrap;
}

/* Figma template button focus/unfocus overrides */
.button-flat-2:hover {
    background-color: rgba(122, 87, 23, 0.35);
    color: var(--text-highlight);
}

.button-flat-2.uitk-focus {
    background-color: var(--accent-focus-wash);
    color: var(--text-highlight);
}

.button-slab:hover {
    background-color: var(--bg-raised);
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.button-slab.uitk-focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.button-primary:hover {
    background-color: var(--text-highlight);
    border-color: var(--text-highlight);
}

.button-primary.uitk-focus {
    background-color: var(--text-highlight);
    border-color: var(--text-highlight);
}

.button-primary > Label {
    color: var(--text-on-accent);
}

.button-slab > Label {
    color: var(--text-primary);
}

.button-slab:hover > Label,
.button-slab.uitk-focus > Label {
    color: var(--text-highlight);
}

.button-danger {
    padding-top: 6px;
    padding-right: 20px;
    padding-bottom: 6px;
    padding-left: 20px;
    border-width: 2px;
    border-color: var(--vital-hp-low);
    background-color: rgba(40, 14, 18, 1);
    color: var(--vital-hp-low);
    font-size: 20px;
    white-space: nowrap;
    justify-content: center;
    align-items: center;
}

.button-danger:hover,
.button-danger.uitk-focus {
    background-color: rgba(180, 44, 34, 1);
    color: var(--text-primary);
    border-color: var(--text-highlight);
}

.button-flat.uitk-unfocused {
    background-color: rgba(0, 0, 0, 0);
}

.button-flat.uitk-unfocused > .button-flat__e {
    visibility: hidden;
}

.button-flat.uitk-unfocused > .button-flat__e-2 {
    color: var(--text-primary);
}

.button-primary-2.uitk-unfocused {
    background-color: var(--accent-gold);
    border-color: var(--border-focus);
}

.button-primary-2.uitk-unfocused > .button-primary-2__e {
    visibility: hidden;
}

.button-slab-2.uitk-unfocused {
    background-color: var(--bg-panel);
    border-color: var(--border-default);
}

.button-slab-2.uitk-unfocused > .button-slab-2__e {
    visibility: hidden;
}

.button-slab-2.uitk-unfocused > .button-slab-2__e-2 {
    color: var(--text-primary);
}

/* Slot Cards (Load / Save) */
.uitk-slot-interactive {
    border-width: 2px;
    border-color: var(--border-line);
    background-color: var(--bg-panel);
}

.uitk-slot-interactive:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-raised);
}

.uitk-slot-interactive.uitk-selected,
.uitk-slot-interactive.uitk-focus {
    border-color: var(--border-accent);
    background-color: var(--bg-raised);
}

/* Selectable Cards (Character Creation Race / Class / Background / Gear / Party) */
.uitk-card {
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-line);
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 6px;
    padding-left: 10px;
    margin-bottom: 6px;
}

.uitk-card:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-raised);
}

.uitk-card.uitk-selected,
.uitk-card.uitk-focus {
    border-color: var(--border-accent);
    background-color: var(--bg-raised);
}

.uitk-card-title {
    font-size: 18px;
    color: var(--text-primary);
    white-space: nowrap;
}

.uitk-card.uitk-selected .uitk-card-title,
.uitk-card.uitk-focus .uitk-card-title {
    color: var(--text-highlight);
}

.uitk-card-sub {
    font-size: 12px;
    letter-spacing: 0.48px;
    color: var(--text-muted);
    white-space: normal;
}

/* Badges & Tags */
.uitk-badge-gold {
    background-color: rgba(43, 34, 16, 1);
    border-width: 1px;
    border-color: var(--border-focus);
    color: var(--text-highlight);
    padding-top: 2px;
    padding-right: 8px;
    padding-bottom: 2px;
    padding-left: 8px;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
}

.uitk-badge-ok {
    background-color: rgba(14, 40, 24, 1);
    border-width: 1px;
    border-color: var(--vital-hp);
    color: var(--vital-hp);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

.uitk-badge-err {
    background-color: rgba(40, 14, 18, 1);
    border-width: 1px;
    border-color: var(--vital-hp-low);
    color: var(--vital-hp-low);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

/* Settings Interactive Controls */
.uitk-settings-row {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: var(--border-line);
    padding-right: 12px;
    padding-left: 12px;
}

.uitk-settings-row.uitk-focus {
    background-color: rgba(242, 194, 91, 0.08);
}

.uitk-dirty-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-gold);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-dirty-dot-off {
    width: 8px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-seg-wrap {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-width: 2px;
    border-color: var(--border-default);
    background-color: var(--bg-void);
}

.uitk-seg-wrap.uitk-focus {
    border-color: var(--text-highlight);
}

.uitk-seg-opt {
    padding-top: 3px;
    padding-right: 12px;
    padding-bottom: 3px;
    padding-left: 12px;
    margin-right: 4px;
    font-size: 16px;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    white-space: nowrap;
}

.uitk-seg-opt.uitk-selected {
    background-color: var(--accent-gold);
    color: var(--text-on-accent);
}

/* Modal Backdrop & Dialog */
.uitk-modal-backdrop {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(4, 6, 12, 0.88);
    align-items: center;
    justify-content: center;
}

.uitk-modal-panel {
    width: 640px;
    padding-top: 22px;
    padding-right: 26px;
    padding-bottom: 22px;
    padding-left: 26px;
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-accent);
}

.uitk-modal-title {
    font-size: 24px;
    color: var(--text-highlight);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.uitk-modal-divider {
    height: 2px;
    background-color: var(--border-focus);
    margin-bottom: 16px;
}

.uitk-modal-message {
    font-size: 18px;
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: 24px;
}

.uitk-modal-buttons {
    flex-direction: row;
    justify-content: center;
}

.uitk-modal-btn {
    width: 200px;
    margin-right: 16px;
    margin-left: 16px;
}

/* Fade Overlay */
.uitk-fade-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: var(--bg-void);
}

/* Right-anchored currency badges so large numbers (10,000+) never clip off 1280px edge */
.uitk-currency-right {
    position: absolute;
    right: 24px;
    left: auto;
}

/* Scrollable lists & grids */
.uitk-scroll-view {
    flex-grow: 1;
}

.uitk-scroll-view .unity-scroller--vertical {
    width: 10px;
}

.uitk-scroll-view .unity-base-slider__tracker {
    background-color: var(--ink-0);
    border-width: 1px;
    border-color: var(--ink-4);
}

.uitk-scroll-view .unity-base-slider__dragger {
    background-color: var(--gold-3);
    border-width: 1px;
    border-color: var(--gold-2);
}

/* Text input field (Character Creation Name) */
.uitk-textfield {
    margin-bottom: 12px;
}

.uitk-textfield > .unity-base-text-field__input {
    background-color: var(--ink-0);
    border-width: 2px;
    border-color: var(--border-default);
    color: var(--text-primary);
    font-size: 22px;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaUIFont.asset");
}

.uitk-textfield > .unity-base-text-field__input:focus {
    border-color: var(--border-accent);
    background-color: var(--ink-1);
}

/* Opening Sequence Screen */
.uitk-opening-root {
    flex-grow: 1;
    background-color: var(--bg-ground);
    padding-top: 36px;
    padding-right: 48px;
    padding-bottom: 36px;
    padding-left: 48px;
    justify-content: space-between;
}

.uitk-opening-panel {
    flex-grow: 1;
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-focus);
    padding-top: 28px;
    padding-right: 36px;
    padding-bottom: 28px;
    padding-left: 36px;
}

.uitk-opening-title {
    font-size: 28px;
    color: var(--text-highlight);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.uitk-opening-story {
    font-size: 20px;
    color: var(--text-primary);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.uitk-opening-cards {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
}

.uitk-opening-card {
    width: 250px;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
}

.uitk-opening-portrait {
    width: 96px;
    height: 96px;
    margin-bottom: 16px;
}

.uitk-opening-name {
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 6px;
}

.uitk-opening-race {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.uitk-opening-class {
    font-size: 16px;
    color: var(--text-highlight);
}

.uitk-opening-footer {
    align-items: center;
    margin-top: 24px;
}
