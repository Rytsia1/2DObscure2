.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e {
    margin-bottom: 8px;
}

.reward-card__e-4.reward-card__e-4.reward-card__e-4.reward-card__e-4.reward-card__e-4.reward-card__e-4.reward-card__e-4,
.reward-card-2__e-4.reward-card-2__e-4.reward-card-2__e-4.reward-card-2__e-4.reward-card-2__e-4.reward-card-2__e-4.reward-card-2__e-4 {
    margin-bottom: 10px;
}

.reward-card__e-5.reward-card__e-5.reward-card__e-5.reward-card__e-5.reward-card__e-5.reward-card__e-5.reward-card__e-5,
.reward-card-2__e-5.reward-card-2__e-5.reward-card-2__e-5.reward-card-2__e-5.reward-card-2__e-5.reward-card-2__e-5.reward-card-2__e-5 {
    margin-bottom: 6px;
}

.reward-card__e-6.reward-card__e-6.reward-card__e-6.reward-card__e-6.reward-card__e-6.reward-card__e-6.reward-card__e-6,
.reward-card-2__e-6.reward-card-2__e-6.reward-card-2__e-6.reward-card-2__e-6.reward-card-2__e-6.reward-card-2__e-6.reward-card-2__e-6 {
    margin-bottom: 8px;
    max-height: 76px;
    overflow: hidden;
}

.reward-card__e-7.reward-card__e-7.reward-card__e-7.reward-card__e-7.reward-card__e-7.reward-card__e-7.reward-card__e-7,
.reward-card-2__e-7.reward-card-2__e-7.reward-card-2__e-7.reward-card-2__e-7.reward-card-2__e-7.reward-card-2__e-7.reward-card-2__e-7 {
    margin-bottom: 8px;
}

.mouse-active .reward-card:hover {
    background-color: var(--bg-raised);
    border-color: var(--border-focus);
}

.mouse-active .reward-card-2:hover {
    background-color: #2A3145;
    border-color: #FFF4D2;
}

/* Slot Cards (Load / Save) */
.uitk-slot-interactive {
    border-width: 2px;
    border-color: var(--border-line);
    background-color: var(--bg-panel);
    overflow: hidden;
}

.mouse-active .uitk-slot-interactive:hover,
.uitk-slot-interactive.uitk-hover {
    border-color: var(--border-focus);
    background-color: #252B3D;
}

.uitk-slot-interactive.uitk-selected,
.uitk-slot-interactive.uitk-focus {
    border-color: var(--border-accent);
    background-color: var(--bg-raised);
}

/* Selectable Cards (Character Creation Race / Class / Background / Gear / Party) */
.uitk-card {
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-line);
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 6px;
    padding-left: 10px;
    margin-bottom: 6px;
    overflow: hidden;
}

.mouse-active .uitk-card:hover,
.uitk-card.uitk-hover {
    border-color: var(--border-focus);
    background-color: #242B3E;
}

/* Locked-in / Selected choice: distinct warm gold card so it never gets confused with cursor hover */
.uitk-card.uitk-selected {
    border-color: var(--gold-2);
    background-color: #231D10;
}

/* Keyboard / Active cursor focus: crisp high-contrast cream border so landing spot is unmistakable */
.uitk-card.uitk-focus {
    border-color: #FFF4D2;
    background-color: #2A344D;
}

.uitk-card.uitk-selected.uitk-focus {
    border-color: #FFF4D2;
    background-color: #382D14;
}

.uitk-card:active {
    background-color: #171C29;
}

.uitk-card-cursor {
    width: 14px;
    margin-right: 2px;
    font-size: 14px;
    color: #FFF4D2;
    flex-shrink: 0;
}

.uitk-locked-badge {
    font-size: 12px;
    color: var(--gold-1);
    margin-left: 6px;
    flex-shrink: 0;
}

.uitk-card-title {
    font-size: 18px;
    color: var(--text-primary);
    white-space: nowrap;
}

.mouse-active .uitk-card:hover .uitk-card-title,
.uitk-card.uitk-hover .uitk-card-title,
.uitk-card.uitk-focus .uitk-card-title {
    color: #FFF4D2;
}

.uitk-card.uitk-selected .uitk-card-title {
    color: var(--text-highlight);
}

.uitk-card-sub {
    font-size: 12px;
    letter-spacing: 0.48px;
    color: var(--text-muted);
    white-space: normal;
}

/* Badges & Tags */
.uitk-badge-gold {
    background-color: rgba(43, 34, 16, 1);
    border-width: 1px;
    border-color: var(--border-focus);
    color: var(--text-highlight);
    padding-top: 2px;
    padding-right: 8px;
    padding-bottom: 2px;
    padding-left: 8px;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
}

.uitk-badge-ok {
    background-color: rgba(14, 40, 24, 1);
    border-width: 1px;
    border-color: var(--vital-hp);
    color: var(--vital-hp);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

.uitk-badge-err {
    background-color: rgba(40, 14, 18, 1);
    border-width: 1px;
    border-color: var(--vital-hp-low);
    color: var(--vital-hp-low);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    font-size: 12px;
    white-space: nowrap;
}

/* Settings Interactive Controls */
.uitk-settings-row {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: var(--border-line);
    padding-right: 12px;
    padding-left: 12px;
}

.mouse-active .uitk-settings-row:hover {
    background-color: rgba(242, 194, 91, 0.06);
}

.uitk-settings-row.uitk-focus {
    background-color: rgba(242, 194, 91, 0.12);
}

.uitk-dirty-dot {
    width: 8px;
    height: 8px;
    background-color: var(--accent-gold);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-dirty-dot-off {
    width: 8px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 10px;
    flex-shrink: 0;
}

.uitk-seg-wrap {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-width: 2px;
    border-color: var(--border-default);
    background-color: var(--bg-void);
}

.mouse-active .uitk-seg-wrap:hover {
    border-color: var(--border-focus);
}

.uitk-seg-wrap.uitk-focus {
    border-color: var(--text-highlight);
}

.uitk-seg-opt {
    padding-top: 3px;
    padding-right: 12px;
    padding-bottom: 3px;
    padding-left: 12px;
    margin-right: 4px;
    font-size: 16px;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    white-space: nowrap;
}

.mouse-active .uitk-seg-opt:hover {
    background-color: rgba(242, 194, 91, 0.18);
    color: var(--text-primary);
}

.uitk-seg-opt.uitk-selected {
    background-color: var(--accent-gold);
    color: var(--text-on-accent);
}

.mouse-active .uitk-seg-opt.uitk-selected:hover {
    background-color: var(--gold-1);
    color: var(--text-on-accent);
}

.uitk-slider-track {
    border-width: 1px;
    border-color: var(--border-default);
}

.mouse-active .uitk-slider-track:hover {
    border-color: var(--border-accent);
}

/* Modal Backdrop & Dialog */
.uitk-modal-backdrop {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(4, 6, 12, 0.88);
    align-items: center;
    justify-content: center;
}

.uitk-modal-panel {
    width: 640px;
    padding-top: 22px;
    padding-right: 26px;
    padding-bottom: 22px;
    padding-left: 26px;
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-accent);
}

.uitk-modal-title {
    font-size: 24px;
    color: var(--text-highlight);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.uitk-modal-divider {
    height: 2px;
    background-color: var(--border-focus);
    margin-bottom: 16px;
}

.uitk-modal-message {
    font-size: 18px;
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: 24px;
}

.uitk-modal-buttons {
    flex-direction: row;
    justify-content: center;
}

.uitk-modal-btn {
    width: 200px;
    margin-right: 16px;
    margin-left: 16px;
}

/* Fade Overlay */
.uitk-fade-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: var(--bg-void);
}

/* Right-anchored currency badges so large numbers (10,000+) never clip off 1280px edge */
.uitk-currency-right {
    position: absolute;
    right: 24px;
    left: auto;
}

/* Scrollable lists & grids.
   FigmaRuntimeTheme skips unity-theme://default, so full structural ScrollView + Scroller layout lives here
   so every scrollbar docks cleanly on the right and content stays strictly inside its box/card. */
.unity-scroll-view {
    overflow: hidden;
    min-height: 0px;
    min-width: 0px;
    flex-direction: column;
}

.unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0px;
    overflow: hidden;
}

.unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0px;
    min-width: 0px;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    flex-shrink: 0;
}

.unity-scroll-view__horizontal-scroller {
    display: none;
}

.unity-scroll-view__vertical-scroller {
    width: 10px;
    flex-shrink: 0;
    flex-direction: column;
    margin-left: 4px;
    background-color: var(--ink-0);
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical > .unity-scroller__slider {
    flex-grow: 1;
    min-width: 10px;
    width: 10px;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
    padding-top: 0px;
    padding-right: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
}

.unity-scroller--vertical .unity-base-slider__input {
    flex-grow: 1;
    flex-direction: column;
}

.unity-scroller--vertical .unity-base-slider__drag-container {
    flex-grow: 1;
    position: relative;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    background-color: var(--ink-0);
    border-width: 1px;
    border-color: var(--ink-4);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    position: absolute;
    left: 1px;
    right: 1px;
    min-height: 24px;
    background-color: var(--gold-3);
    border-width: 1px;
    border-color: var(--gold-2);
}

.mouse-active .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--gold-2);
    border-color: var(--gold-1);
}

.unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: var(--gold-1);
    border-color: var(--text-primary);
}

.uitk-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0px;
    overflow: hidden;
}

/* Disabled overrides MUST appear AFTER all hover/focus/active rules (USS has no :not()). */
.uitk-disabled,
.mouse-active .uitk-disabled:hover,
.uitk-disabled:active {
    opacity: 0.42;
}

.uitk-flat-item.uitk-disabled,
.mouse-active .uitk-flat-item.uitk-disabled:hover,
.uitk-flat-item.uitk-disabled:active,
.button-flat-2.uitk-disabled,
.mouse-active .button-flat-2.uitk-disabled:hover,
.button-flat-2.uitk-disabled:active,
.button-flat.uitk-disabled,
.mouse-active .button-flat.uitk-disabled:hover,
.button-flat.uitk-disabled:active {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-muted);
}

.uitk-flat-item.uitk-disabled > .uitk-flat-label,
.mouse-active .uitk-flat-item.uitk-disabled:hover > .uitk-flat-label,
.button-flat-2.uitk-disabled > Label,
.mouse-active .button-flat-2.uitk-disabled:hover > Label,
.button-flat.uitk-disabled > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2,
.mouse-active .button-flat.uitk-disabled:hover > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2 {
    color: var(--text-muted);
}

.button-slab.uitk-disabled,
.mouse-active .button-slab.uitk-disabled:hover,
.button-slab.uitk-disabled:active,
.button-slab-2.uitk-disabled,
.mouse-active .button-slab-2.uitk-disabled:hover,
.button-slab-2.uitk-disabled:active {
    background-color: var(--bg-panel);
    border-color: var(--border-line);
    color: var(--text-muted);
}

.button-slab.uitk-disabled > Label,
.mouse-active .button-slab.uitk-disabled:hover > Label {
    color: var(--text-muted);
}

.button-primary.uitk-disabled,
.mouse-active .button-primary.uitk-disabled:hover,
.button-primary.uitk-disabled:active,
.button-primary-2.uitk-disabled,
.mouse-active .button-primary-2.uitk-disabled:hover,
.button-primary-2.uitk-disabled:active {
    background-color: var(--ink-3);
    border-color: var(--border-line);
    color: var(--text-muted);
}

.button-primary.uitk-disabled > Label,
.mouse-active .button-primary.uitk-disabled:hover > Label {
    color: var(--text-muted);
}

.button-danger.uitk-disabled,
.mouse-active .button-danger.uitk-disabled:hover,
.button-danger.uitk-disabled:active {
    background-color: var(--bg-panel);
    border-color: var(--border-line);
    color: var(--text-muted);
}

.button-danger.uitk-disabled > Label,
.mouse-active .button-danger.uitk-disabled:hover > Label {
    color: var(--text-muted);
}

.uitk-card.uitk-disabled,
.mouse-active .uitk-card.uitk-disabled:hover,
.uitk-card.uitk-disabled:active,
.uitk-slot-interactive.uitk-disabled,
.mouse-active .uitk-slot-interactive.uitk-disabled:hover,
.uitk-slot-interactive.uitk-disabled:active,
.list-row-2.uitk-disabled,
.mouse-active .list-row-2.uitk-disabled:hover,
.list-row-2.uitk-disabled:active,
.uitk-tab-btn.uitk-disabled,
.mouse-active .uitk-tab-btn.uitk-disabled:hover,
.uitk-tag-btn.uitk-disabled,
.mouse-active .uitk-tag-btn.uitk-disabled:hover,
.uitk-stepper-btn.uitk-disabled,
.mouse-active .uitk-stepper-btn.uitk-disabled:hover {
    background-color: var(--bg-panel);
    border-color: var(--border-line);
}

.uitk-card.uitk-disabled .uitk-card-title,
.mouse-active .uitk-card.uitk-disabled:hover .uitk-card-title,
.uitk-tab-btn.uitk-disabled > Label,
.mouse-active .uitk-tab-btn.uitk-disabled:hover > Label {
    color: var(--text-muted);
}

/* Subtle muted focus border for keyboard users stepping onto a disabled control */
.uitk-disabled.uitk-focus {
    border-color: var(--border-default);
}

/* Text input field (Character Creation Name) */
.uitk-textfield {
    margin-bottom: 12px;
}

.uitk-textfield > .unity-base-text-field__input {
    background-color: var(--ink-0);
    border-width: 2px;
    border-color: var(--border-default);
    color: var(--text-primary);
    font-size: 22px;
    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaUIFont.asset");
}

.uitk-textfield > .unity-base-text-field__input:focus {
    border-color: var(--border-accent);
    background-color: var(--ink-1);
}

/* Opening Sequence Screen */
.uitk-opening-root {
    flex-grow: 1;
    background-color: var(--bg-ground);
    padding-top: 36px;
    padding-right: 48px;
    padding-bottom: 36px;
    padding-left: 48px;
    justify-content: space-between;
}

.uitk-opening-panel {
    flex-grow: 1;
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-focus);
    padding-top: 28px;
    padding-right: 36px;
    padding-bottom: 28px;
    padding-left: 36px;
}

.uitk-opening-title {
    font-size: 28px;
    color: var(--text-highlight);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.uitk-opening-story {
    font-size: 20px;
    color: var(--text-primary);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.uitk-opening-cards {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
}

.uitk-opening-card {
    width: 250px;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
}

.uitk-opening-portrait {
    width: 96px;
    height: 96px;
    margin-bottom: 16px;
}

.uitk-opening-name {
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 6px;
}

.uitk-opening-race {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.uitk-opening-class {
    font-size: 16px;
    color: var(--text-highlight);
}

.uitk-opening-footer {
    align-items: center;
    margin-top: 24px;
}
