/* Shared runtime styles for FELNA Figma UI Toolkit screens.
   Follows strict Unity USS subset (no gap, border shorthand, z-index, or box-shadow). */

.uitk-screen-root {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    justify-content: center;
    align-items: center;
    background-color: #090C14;
}

/* Default face set at the root so it INHERITS. Never target Label/.unity-label here:
   a direct match beats inheritance and would force Inter onto every label inside
   Gothic/Display containers (buttons, tabs, headers). */
:root,
.unity-ui-document__root,
.uitk-screen-root,
.uitk-font-ui {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaUIFont.asset");
}

/* Display Serif (Cinzel Bold) — Titles, Screen Headers, Modals, Prologue */
.uitk-font-display,
.felna-vars,
.victory-vars,
.dungeon-clear-vars,
.uitk-opening-title,
.uitk-modal-title,
.settings-vars,
.create-character-vars,
.load-game-vars,
.geistwald-city-vars,
.party-vars,
.shop-vars-2,
.armory-vars-2,
.blacksmith-vars-2,
.temple-vars-2,
.magic-shop-vars-2,
.save-game-vars,
.the-sunken-crypt-vars,
.status-vars,
.inventory-vars-2,
.equipment-vars-4,
.training-ground-vars-2,
.talents-vars,
.wandering-merchant-vars,
.the-sunken-crypt-vars-3,
.the-sunken-crypt-vars-4,
.create-character-vars-2,
.victory-vars-2,
.zoroa-harvester-of-souls-vars {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaDisplayFont.asset");
}

/* Pixel Gothic (DotGothic16) — Section Headers, Buttons, Menu Rows, Card Titles, Tabs */
.uitk-font-gothic,
Button,
.unity-button,
.unity-button > .unity-label,
.button-flat,
.button-flat-2,
.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2,
.button-slab,
.button-slab-2,
.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2,
.button-primary,
.button-primary-2,
.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2.button-primary-2__e-2,
.button-danger,
.section-header,
.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3.section-header__e-3,
.uitk-card-title,
.uitk-flat-label,
.uitk-tab-btn,
.uitk-opening-name {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/FelnaGothicFont.asset");
}

.button-flat-2 {
    -unity-text-align: middle-left;
}

.section-header {
    width: auto;
    height: auto;
    min-height: 34px;
    overflow: visible;
    align-self: stretch;
}

.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e.section-header__e {
    overflow: visible;
}

.uitk-hidden {
    display: none;
}

.uitk-cursor-hidden {
    visibility: hidden;
}

.uitk-cursor-visible {
    visibility: visible;
}

/* Interactive flat navigation rows (e.g. Main Menu, Settings category, Hub facilities) */
.uitk-flat-item {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-right: 16px;
    padding-bottom: 7px;
    padding-left: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.mouse-active .uitk-flat-item:hover,
.uitk-flat-item.uitk-hover {
    background-color: rgba(154, 114, 34, 0.34);
    border-color: var(--border-focus);
}

.uitk-flat-item.uitk-focus {
    background-color: var(--accent-focus-wash);
    border-color: var(--border-accent);
}

.uitk-flat-item:active {
    background-color: rgba(242, 194, 91, 0.24);
}

.uitk-flat-item.uitk-selected {
    border-width: 1px;
    border-color: var(--gold-3);
    background-color: rgba(242, 194, 91, 0.14);
}

.uitk-flat-cursor {
    width: 18px;
    margin-right: 4px;
    color: var(--text-highlight);
    font-size: 20px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.uitk-flat-label {
    color: var(--text-primary);
    font-size: 20px;
    white-space: nowrap;
    flex-grow: 1;
}

.mouse-active .uitk-flat-item:hover > .uitk-flat-label,
.uitk-flat-item.uitk-hover > .uitk-flat-label,
.uitk-flat-item.uitk-focus > .uitk-flat-label,
.uitk-flat-item.uitk-selected > .uitk-flat-label {
    color: var(--text-highlight);
}

.uitk-flat-sub {
    color: var(--text-body);
    font-size: 13px;
    letter-spacing: 0.4px;
    white-space: nowrap;
}

/* Figma template & runtime button normal / hover / focus / active states */
.button-flat-2 {
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.mouse-active .button-flat-2:hover,
.button-flat-2.uitk-hover {
    background-color: rgba(154, 114, 34, 0.34);
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.button-flat-2.uitk-focus {
    background-color: var(--accent-focus-wash);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.button-flat-2:active {
    background-color: rgba(242, 194, 91, 0.24);
}

.mouse-active .button-flat-2:hover > Label,
.button-flat-2.uitk-hover > Label,
.button-flat-2.uitk-focus > Label {
    color: var(--text-highlight);
}

.button-slab {
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-default);
    color: var(--text-primary);
}

.button-slab > Label {
    color: var(--text-primary);
}

.mouse-active .button-slab:hover,
.button-slab.uitk-hover {
    background-color: #272E42;
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.button-slab.uitk-focus {
    background-color: #2E364D;
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.button-slab:active {
    background-color: #171C29;
    border-color: var(--text-highlight);
}

.mouse-active .button-slab:hover > Label,
.button-slab.uitk-hover > Label,
.button-slab.uitk-focus > Label {
    color: var(--text-highlight);
}

.button-primary {
    background-color: var(--accent-gold);
    border-width: 2px;
    border-color: var(--gold-1);
    padding-top: 6px;
    padding-right: 16px;
    padding-bottom: 6px;
    padding-left: 16px;
    color: var(--text-on-accent);
    font-size: 20px;
    white-space: nowrap;
    justify-content: center;
    align-items: center;
}

.button-primary > Label {
    color: var(--text-on-accent);
    font-size: 20px;
}

.mouse-active .button-primary:hover,
.button-primary.uitk-hover {
    background-color: var(--gold-1);
    border-color: #FFF4D2;
}

.button-primary.uitk-focus {
    background-color: var(--gold-1);
    border-color: #FFF4D2;
}

.button-primary:active {
    background-color: var(--gold-3);
    border-color: var(--gold-1);
}

.button-danger {
    padding-top: 6px;
    padding-right: 20px;
    padding-bottom: 6px;
    padding-left: 20px;
    border-width: 2px;
    border-color: var(--vital-hp-low);
    background-color: rgba(44, 14, 18, 1);
    color: var(--vital-hp-low);
    font-size: 20px;
    white-space: nowrap;
    justify-content: center;
    align-items: center;
}

.button-danger > Label {
    color: var(--vital-hp-low);
    font-size: 20px;
}

.mouse-active .button-danger:hover,
.button-danger.uitk-hover {
    background-color: rgba(152, 34, 28, 1);
    color: var(--text-primary);
    border-color: var(--text-highlight);
}

.button-danger.uitk-focus {
    background-color: rgba(184, 44, 34, 1);
    color: var(--text-primary);
    border-color: #FFF4D2;
}

.button-danger:active {
    background-color: rgba(110, 22, 18, 1);
    border-color: var(--vital-hp-low);
}

.mouse-active .button-danger:hover > Label,
.button-danger.uitk-hover > Label,
.button-danger.uitk-focus > Label {
    color: var(--text-primary);
}

/* Figma Focus-variant button templates (Button-Flat-Focus, Button-Primary-Focus, Button-Slab-Focus) */
.button-flat {
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.button-flat.uitk-unfocused {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.button-flat.uitk-unfocused > .button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e {
    visibility: hidden;
}

.button-flat.uitk-unfocused > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2 {
    color: var(--text-primary);
}

.mouse-active .button-flat:hover,
.button-flat.uitk-hover {
    background-color: rgba(154, 114, 34, 0.34);
    border-color: var(--border-focus);
}

.button-flat.uitk-focus {
    background-color: var(--accent-focus-wash);
    border-color: var(--border-accent);
}

.button-flat:active {
    background-color: rgba(242, 194, 91, 0.25);
}

.mouse-active .button-flat:hover > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2,
.button-flat.uitk-hover > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2,
.button-flat.uitk-focus > .button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2.button-flat__e-2 {
    color: var(--text-highlight);
}

.button-primary-2.uitk-unfocused {
    background-color: var(--accent-gold);
    border-color: var(--border-focus);
}

.button-primary-2.uitk-unfocused > .button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e {
    visibility: hidden;
}

.mouse-active .button-primary-2:hover,
.button-primary-2.uitk-hover {
    background-color: var(--gold-1);
    border-color: #FFF4D2;
}

.button-primary-2.uitk-focus {
    background-color: var(--gold-1);
    border-color: #FFF4D2;
}

.button-primary-2:active {
    background-color: var(--gold-3);
    border-color: var(--gold-1);
}

.button-slab-2.uitk-unfocused {
    background-color: var(--bg-panel);
    border-color: var(--border-default);
}

.button-slab-2.uitk-unfocused > .button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e {
    visibility: hidden;
}

.button-slab-2.uitk-unfocused > .button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2 {
    color: var(--text-primary);
}

.mouse-active .button-slab-2:hover,
.button-slab-2.uitk-hover {
    background-color: #272E42;
    border-color: var(--border-focus);
}

.button-slab-2.uitk-focus {
    background-color: #2E364D;
    border-color: var(--border-accent);
}

.button-slab-2:active {
    background-color: #171C29;
    border-color: var(--text-highlight);
}

.mouse-active .button-slab-2:hover > .button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2,
.button-slab-2.uitk-hover > .button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2,
.button-slab-2.uitk-focus > .button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2.button-slab-2__e-2 {
    color: var(--text-highlight);
}

/* Shared Tab Buttons (Inventory, Status, Talents, Shop, Armory, Blacksmith, Magic Shop) */
.uitk-tab-btn {
    background-color: var(--bg-panel);
    border-width: 2px;
    border-color: var(--border-line);
    color: var(--text-body);
    justify-content: center;
    align-items: center;
}

.uitk-tab-btn > Label {
    color: var(--text-body);
}

.mouse-active .uitk-tab-btn:hover,
.uitk-tab-btn.uitk-hover {
    background-color: #252C3E;
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.mouse-active .uitk-tab-btn:hover > Label,
.uitk-tab-btn.uitk-hover > Label {
    color: var(--text-highlight);
}

.uitk-tab-btn.uitk-tab-active,
.uitk-tab-btn.uitk-selected {
    background-color: rgba(242, 194, 91, 0.16);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.uitk-tab-btn.uitk-tab-active > Label,
.uitk-tab-btn.uitk-selected > Label {
    color: var(--text-highlight);
}

.uitk-tab-btn.uitk-focus {
    background-color: rgba(242, 194, 91, 0.24);
    border-color: #FFF4D2;
    color: var(--text-highlight);
}

.uitk-tab-btn.uitk-focus > Label {
    color: var(--text-highlight);
}

.uitk-tab-btn:active {
    background-color: rgba(242, 194, 91, 0.30);
}

/* Filter Chips & Clickable Header Tags */
.uitk-filter-chip {
    opacity: 0.78;
    border-width: 1px;
    border-color: var(--border-line);
}

.mouse-active .uitk-filter-chip:hover,
.uitk-filter-chip.uitk-hover {
    opacity: 1;
    border-color: var(--border-focus);
    background-color: rgba(154, 114, 34, 0.24);
}

.uitk-filter-chip.uitk-selected,
.uitk-filter-chip.uitk-filter-active {
    opacity: 1;
    border-width: 2px;
    border-color: var(--border-accent);
    background-color: rgba(242, 194, 91, 0.18);
}

.uitk-filter-chip.uitk-focus {
    opacity: 1;
    border-width: 2px;
    border-color: #FFF4D2;
}

.uitk-tag-btn {
    border-width: 2px;
    border-color: var(--border-focus);
    background-color: rgba(34, 28, 16, 0.92);
}

.mouse-active .uitk-tag-btn:hover,
.uitk-tag-btn.uitk-hover {
    border-color: var(--border-accent);
    background-color: rgba(154, 114, 34, 0.38);
}

.uitk-tag-btn.uitk-focus {
    border-color: #FFF4D2;
    background-color: rgba(242, 194, 91, 0.28);
}

.uitk-tag-btn:active {
    background-color: rgba(242, 194, 91, 0.38);
}

/* Character Creation Step Chips & Steppers */
.uitk-step-chip {
    border-width: 2px;
}

.mouse-active .uitk-step-chip:hover,
.uitk-step-chip.uitk-hover {
    border-color: var(--border-accent);
    background-color: #2A3145;
}

.uitk-step-chip:active {
    background-color: #181D2B;
}

.uitk-stepper-btn {
    border-width: 2px;
    border-color: var(--border-default);
    background-color: var(--bg-raised);
}

.mouse-active .uitk-stepper-btn:hover,
.uitk-stepper-btn.uitk-hover {
    border-color: var(--border-accent);
    background-color: rgba(242, 194, 91, 0.22);
}

.uitk-stepper-btn:active {
    background-color: rgba(242, 194, 91, 0.34);
    border-color: #FFF4D2;
}

/* Clickable Key-Caps (Q/E Hero Switchers) & Interactive Bars (Run Effects, Legend) */
.uitk-key-btn {
    border-width: 2px;
    border-color: var(--border-default);
    background-color: var(--bg-panel);
}

.mouse-active .uitk-key-btn:hover,
.uitk-key-btn.uitk-hover {
    border-color: var(--border-accent);
    background-color: #2A3248;
}

.uitk-key-btn:active {
    background-color: rgba(242, 194, 91, 0.24);
}

.uitk-clickable-bar {
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.mouse-active .uitk-clickable-bar:hover,
.uitk-clickable-bar.uitk-hover {
    border-color: var(--border-focus);
    background-color: rgba(242, 194, 91, 0.14);
}

.uitk-clickable-bar:active {
    background-color: rgba(242, 194, 91, 0.24);
}

/* Portrait / Hero Switcher Buttons */
.uitk-portrait-btn {
    border-width: 2px;
    border-color: var(--border-line);
}

.mouse-active .uitk-portrait-btn:hover,
.uitk-portrait-btn.uitk-hover {
    border-color: var(--border-focus);
    background-color: #262E42;
}

.uitk-portrait-btn.uitk-selected,
.uitk-portrait-btn.uitk-focus {
    border-color: var(--border-accent);
}

/* List-Row Template Hover / Focus */
.list-row-2 {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.mouse-active .list-row-2:hover,
.list-row-2.uitk-hover {
    background-color: rgba(122, 87, 23, 0.28);
    border-color: var(--border-focus);
}

.list-row-2.uitk-focus {
    background-color: #2B2210;
    border-color: var(--border-accent);
}

.list-row-2.uitk-selected {
    background-color: rgba(242, 194, 91, 0.14);
    border-color: var(--gold-3);
}

/* Figma template flex rows lack CSS gap (unsupported in USS); restore visual spacing cleanly. */
.key-hint {
    margin-right: 16px;
}

.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e {
    margin-right: 6px;
}

.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e,
.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e {
    margin-right: 8px;
}

.effect-chip-overflow__e.effect-chip-overflow__e.effect-chip-overflow__e.effect-chip-overflow__e.effect-chip-overflow__e.effect-chip-overflow__e.effect-chip-overflow__e {
    margin-right: 6px;
}

.toast-info__e.toast-info__e.toast-info__e.toast-info__e.toast-info__e.toast-info__e.toast-info__e,
.toast-error__e.toast-error__e.toast-error__e.toast-error__e.toast-error__e.toast-error__e.toast-error__e {
    margin-right: 10px;
}

.button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e.button-flat__e,
.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e.button-primary-2__e,
.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e.button-slab-2__e {
    margin-right: 6px;
}

.list-row-2__e.list-row-2__e.list-row-2__e.list-row-2__e.list-row-2__e.list-row-2__e.list-row-2__e {
    margin-right: 10px;
}

.list-row-2__e-2.list-row-2__e-2.list-row-2__e-2.list-row-2__e-2.list-row-2__e-2.list-row-2__e-2.list-row-2__e-2 {
    margin-right: 10px;
}

.stat-stepper-2__e.stat-stepper-2__e.stat-stepper-2__e.stat-stepper-2__e.stat-stepper-2__e.stat-stepper-2__e.stat-stepper-2__e,
.stat-stepper-2__e-3.stat-stepper-2__e-3.stat-stepper-2__e-3.stat-stepper-2__e-3.stat-stepper-2__e-3.stat-stepper-2__e-3.stat-stepper-2__e-3 {
    margin-right: 4px;
