.slot-card {
    display: flex;
    width: 580px;
    height: 112px;
    padding: 14px 18px;
    flex-direction: column;
    align-items: flex-start;
    border-width: 2px;
    background-color: var(--bg-panel);
    border-color: var(--border-focus);
}

.slot-card__e.slot-card__e.slot-card__e.slot-card__e.slot-card__e.slot-card__e.slot-card__e {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    align-self: stretch;
    overflow: hidden;
    flex-direction: row;
}

.slot-card__e-2.slot-card__e-2.slot-card__e-2.slot-card__e-2.slot-card__e-2.slot-card__e-2.slot-card__e-2 {
    flex-shrink: 0;
    font-size: 24px;
    white-space: nowrap;
    color: var(--text-highlight);
}

.slot-card__e-3.slot-card__e-3.slot-card__e-3.slot-card__e-3.slot-card__e-3.slot-card__e-3.slot-card__e-3 {
    height: 1px;
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0px;
    overflow: hidden;
}

.slot-card__e-4.slot-card__e-4.slot-card__e-4.slot-card__e-4.slot-card__e-4.slot-card__e-4.slot-card__e-4 {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--status-ok);
}

.slot-card__e-5.slot-card__e-5.slot-card__e-5.slot-card__e-5.slot-card__e-5.slot-card__e-5.slot-card__e-5 {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-primary);
}

.slot-card__e-6.slot-card__e-6.slot-card__e-6.slot-card__e-6.slot-card__e-6.slot-card__e-6.slot-card__e-6 {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-muted);
}

