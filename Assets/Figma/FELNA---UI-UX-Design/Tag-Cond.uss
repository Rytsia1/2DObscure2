.tag-cond {
    display: flex;
    padding: 4px 8px;
    align-items: flex-start;
    border-width: 2px;
    flex-direction: row;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    border-color: var(--text-muted);
    color: var(--text-body);
}

.tag-cond__e.tag-cond__e.tag-cond__e.tag-cond__e.tag-cond__e.tag-cond__e.tag-cond__e {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-body);
}

