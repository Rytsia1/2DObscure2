.button-slab {
    display: flex;
    padding: 6px 20px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--bg-panel);
    border-color: var(--border-default);
    color: var(--text-primary);
}

.button-slab:disabled {
    opacity: 0.85;
    color: var(--text-muted);
}

.button-slab:focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.sprite-knight {
    width: 64px;
    height: 80px;
}

.sprite-rogue {
    width: 64px;
    height: 80px;
}

.sprite-mage {
    width: 64px;
    height: 76px;
}

.sprite-healer {
    width: 64px;
    height: 76px;
}

.gauge-hp {
    display: flex;
    width: 160px;
    height: 10px;
    padding: 1px 47px 1px 1px;
    align-items: flex-start;
    border-width: 1px;
    overflow: hidden;
    flex-direction: row;
    background-color: var(--bg-void);
    border-color: var(--border-line);
}

.gauge-mp {
    display: flex;
    width: 160px;
    height: 10px;
    padding: 1px 47px 1px 1px;
    align-items: flex-start;
    border-width: 1px;
    overflow: hidden;
    flex-direction: row;
    background-color: var(--bg-void);
    border-color: var(--border-line);
}

.frame-4 .unity-tab__header {
    background-color: rgba(0, 0, 0, 0);
    padding: 0px;
    min-height: auto;
    display: flex;
    padding: 6px 16px;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--bg-raised);
    border-color: var(--border-default);
    color: var(--text-body);
}

.frame-4 .unity-tab__header:checked {
    background-color: var(--bg-panel);
    border-color: var(--border-focus);
    color: var(--text-accent);
}

.frame-4 .unity-tab__header:checked:hover {
    color: var(--text-accent);
}

.frame-4 .unity-tab__header > .unity-tab__header-label {
    margin: 0px;
    padding: 0px;
}

.frame-4 .unity-tab__header-underline {
    display: none;
}

._13-character-status {
    width: 1280px;
    height: 720px;
    flex-shrink: 0;
}

.unity-ui-document__root > ._13-character-status {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: auto;
    height: auto;
}

