:root {
    --ink-0: rgba(7, 10, 20, 1);
    --ink-1: rgba(12, 17, 34, 1);
    --ink-2: rgba(18, 26, 49, 1);
    --ink-3: rgba(26, 36, 67, 1);
    --ink-4: rgba(37, 49, 90, 1);
    --ink-5: rgba(58, 72, 120, 1);
    --mist-1: rgba(238, 240, 248, 1);
    --mist-2: rgba(195, 201, 222, 1);
    --mist-3: rgba(143, 152, 184, 1);
    --gold-1: rgba(255, 230, 163, 1);
    --gold-2: rgba(242, 194, 91, 1);
    --gold-3: rgba(201, 147, 46, 1);
    --gold-4: rgba(122, 87, 23, 1);
    --ember-1: rgba(255, 193, 150, 1);
    --ember-2: rgba(239, 138, 60, 1);
    --ember-3: rgba(138, 67, 23, 1);
    --green-1: rgba(82, 209, 140, 1);
    --red-1: rgba(255, 106, 85, 1);
    --blue-1: rgba(90, 162, 255, 1);
    --violet-1: rgba(199, 155, 255, 1);
    --cyan-1: rgba(159, 227, 255, 1);
    --element-fire: rgba(255, 122, 69, 1);
    --element-ice: rgba(143, 220, 247, 1);
    --element-lightning: rgba(245, 224, 74, 1);
    --element-earth: rgba(195, 154, 95, 1);
    --element-wind: rgba(134, 230, 176, 1);
    --element-water: rgba(77, 155, 255, 1);
    --element-holy: rgba(255, 241, 184, 1);
    --element-shadow: rgba(167, 124, 245, 1);
    --element-physical: rgba(201, 206, 217, 1);
    --element-almighty: rgba(255, 124, 191, 1);
    --rarity-common: rgba(167, 175, 196, 1);
    --rarity-uncommon: rgba(95, 208, 143, 1);
    --rarity-rare: rgba(90, 162, 255, 1);
    --rarity-epic: rgba(185, 138, 255, 1);
    --rarity-legendary: rgba(245, 167, 66, 1);
    --rarity-mythic: rgba(255, 111, 142, 1);
    --bg-void: var(--ink-0);
    --bg-ground: var(--ink-1);
    --bg-panel: var(--ink-2);
    --bg-raised: var(--ink-3);
    --border-line: var(--ink-4);
    --border-default: var(--ink-5);
    --border-focus: var(--gold-3);
    --border-accent: var(--gold-2);
    --text-primary: var(--mist-1);
    --text-body: var(--mist-2);
    --text-muted: var(--mist-3);
    --text-accent: var(--gold-2);
    --text-highlight: var(--gold-1);
    --text-on-accent: var(--ink-1);
    --accent-gold: var(--gold-2);
    --accent-gold-dim: var(--gold-4);
    --accent-focus-wash: var(--gold-4);
    --currency-hub: var(--gold-2);
    --currency-run: var(--ember-2);
    --currency-run-text: var(--ember-1);
    --vital-hp: var(--green-1);
    --vital-hp-low: var(--red-1);
    --vital-mp: var(--blue-1);
    --vital-xp: var(--violet-1);
    --vital-shield: var(--cyan-1);
    --status-ok: var(--green-1);
    --status-error: var(--red-1);
    --status-warn: var(--gold-2);
}
