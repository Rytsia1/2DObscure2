.map-node-3 {
    display: flex;
    width: 56px;
    height: 56px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    border-color: var(--border-default);
    color: var(--text-muted);
}

.map-node-3__e.map-node-3__e.map-node-3__e.map-node-3__e.map-node-3__e.map-node-3__e.map-node-3__e {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-muted);
}

