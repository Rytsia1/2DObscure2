            <ui:Label name="text-0" text="EQUIPMENT" class="unity-label reward-card-2__e-2" />
            <ui:Label name="text-1" text="RARE" class="unity-label reward-card-2__e-3" />
        </ui:VisualElement>
        <ui:VisualElement class="reward-card-2__e-4" />
        <ui:Label name="text-2" text="Tideglass Wand" class="unity-label reward-card-2__e-5" />
