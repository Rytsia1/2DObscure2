        <ui:VisualElement class="reward-card-2__e-7" />
        <ui:Label name="text-4" text="VS MAGE'S APPRENTICE STAFF: MAG +3" class="unity-label reward-card-2__e-8" />
        <ui:VisualElement class="reward-card-2__e-9" />
