    right: 0%;
    top: 0%;
    bottom: 0%;
    background-image: url("project://database/Assets/Figma/FELNA---UI-UX-Design/images/img-19ff3c569f83d5d63d90450f2a75e77c-200.svg?fileID=7388822144124034973&guid=779c08d9fee7c784f90090bce42ac89c&type=3#img-19ff3c569f83d5d63d90450f2a75e77c-200");
