.currency-tag-run {
    display: flex;
    padding: 6px 12px 6px 10px;
    align-items: center;
    border-width: 2px;
    background-color: #241008;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    border-color: var(--currency-run);
    color: var(--currency-run-text);
}

.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e.currency-tag-run__e {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    overflow: hidden;
}

.currency-tag-run__e-2.currency-tag-run__e-2.currency-tag-run__e-2.currency-tag-run__e-2.currency-tag-run__e-2.currency-tag-run__e-2.currency-tag-run__e-2 {
