.button-slab {
    display: flex;
    padding: 6px 20px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--bg-panel);
    border-color: var(--border-default);
    color: var(--text-primary);
}

.button-slab:disabled {
    opacity: 0.85;
    color: var(--text-muted);
}

.button-slab:focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

._03-load-game {
    width: 1280px;
    height: 720px;
    flex-shrink: 0;
}

.unity-ui-document__root > ._03-load-game {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: auto;
    height: auto;
}

._03-load-game-vars._03-load-game-vars._03-load-game-vars._03-load-game-vars._03-load-game-vars._03-load-game-vars {
    background-color: var(--bg-ground);
}

