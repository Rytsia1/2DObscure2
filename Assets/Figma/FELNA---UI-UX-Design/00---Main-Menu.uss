.button-flat-2 {
    display: flex;
    padding: 6px 20px 6px 12px;
    align-items: center;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    color: var(--text-primary);
}

.button-flat-2:disabled {
    opacity: 0.6;
    color: var(--text-muted);
}

.button-flat-2:focus {
    background-color: var(--accent-focus-wash);
    color: var(--text-highlight);
}

._00-main-menu {
    width: 1280px;
    height: 720px;
    flex-shrink: 0;
}

.unity-ui-document__root > ._00-main-menu {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: auto;
    height: auto;
}

