.currency-tag-hub {
    display: flex;
    padding: 6px 12px 6px 10px;
    align-items: center;
    border-width: 2px;
    background-color: #221A08;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    border-color: var(--currency-hub);
    color: var(--text-highlight);
}

.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e.currency-tag-hub__e {
    width: 14px;
