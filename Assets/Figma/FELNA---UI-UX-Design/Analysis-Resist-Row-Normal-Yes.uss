.analysis-resist-row-normal-yes {
    display: flex;
    width: 300px;
    height: 30px;
    padding: 3px 6px;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    background-color: var(--accent-focus-wash);
    border-color: var(--border-focus);
}

.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e.analysis-resist-row-normal-yes__e {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-accent);
}

.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2.analysis-resist-row-normal-yes__e-2 {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
}

.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3.analysis-resist-row-normal-yes__e-3 {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0px;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: normal;
    color: var(--text-primary);
}

.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4.analysis-resist-row-normal-yes__e-4 {
    display: flex;
    padding: 2px 6px;
    align-items: flex-start;
    flex-shrink: 0;
    border-width: 2px;
    overflow: hidden;
    flex-direction: row;
    border-color: var(--text-body);
}

.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5.analysis-resist-row-normal-yes__e-5 {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
    color: var(--text-body);
}

.analysis-resist-row-normal-yes__e-2 > .icon-status-burn.icon-status-burn.icon-status-burn.icon-status-burn.icon-status-burn.icon-status-burn.icon-status-burn {
    width: 100%;
    height: 100%;
}

