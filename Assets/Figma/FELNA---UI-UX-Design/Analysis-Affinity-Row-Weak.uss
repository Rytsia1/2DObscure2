.analysis-affinity-row-weak {
    display: flex;
    width: 280px;
    height: 30px;
    padding: 3px 6px;
    align-items: center;
    flex-direction: row;
}

.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e.analysis-affinity-row-weak__e {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
}

.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2.analysis-affinity-row-weak__e-2 {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-accent);
}

.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3.analysis-affinity-row-weak__e-3 {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0px;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: normal;
    color: var(--text-muted);
}

.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4.analysis-affinity-row-weak__e-4 {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
    color: var(--text-muted);
}

.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5.analysis-affinity-row-weak__e-5 {
    display: flex;
