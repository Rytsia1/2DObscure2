.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6.analysis-affinity-row-weak__e-6 {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
    color: var(--status-ok);
}

.analysis-affinity-row-weak__e > .icon-element-fire.icon-element-fire.icon-element-fire.icon-element-fire.icon-element-fire.icon-element-fire.icon-element-fire {
