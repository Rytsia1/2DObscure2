<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="tokens.uss" />
    <Style src="Reward-Card.uss" />
    <ui:VisualElement class="reward-card">
        <ui:VisualElement class="reward-card__e">
            <ui:Label name="text-0" text="EQUIPMENT" class="unity-label reward-card__e-2" />
            <ui:Label name="text-1" text="RARE" class="unity-label reward-card__e-3" />
        </ui:VisualElement>
        <ui:VisualElement class="reward-card__e-4" />
        <ui:Label name="text-2" text="Tideglass Wand" class="unity-label reward-card__e-5" />
        <ui:Label name="text-3" text="MAIN HAND · MAG +7 · WATER SPELLS +10%." class="unity-label reward-card__e-6" />
        <ui:VisualElement class="reward-card__e-7" />
        <ui:Label name="text-4" text="VS MAGE'S APPRENTICE STAFF: MAG +3" class="unity-label reward-card__e-8" />
        <ui:VisualElement class="reward-card__e-9" />
        <ui:VisualElement class="reward-card__e-10">
            <ui:Label name="text-5" text="1" class="unity-label reward-card__e-11" />
            <ui:VisualElement class="reward-card__e-12">
                <ui:Label name="text-6" text="KEPT" class="unity-label reward-card__e-13" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
