.button-flat-2 {
    display: flex;
    padding: 6px 20px 6px 12px;
    align-items: center;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    color: var(--text-primary);
}

.button-flat-2:disabled {
    opacity: 0.6;
    color: var(--text-muted);
}

.button-flat-2:focus {
    background-color: var(--accent-focus-wash);
    color: var(--text-highlight);
}

.button-slab {
    display: flex;
    padding: 6px 20px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--bg-panel);
    border-color: var(--border-default);
    color: var(--text-primary);
}

.button-slab:disabled {
    opacity: 0.85;
    color: var(--text-muted);
}

.button-slab:focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

.button-primary {
    display: flex;
    padding: 6px 20px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--accent-gold);
    border-color: var(--border-focus);
    color: var(--text-on-accent);
}

.button-primary:disabled {
    opacity: 0.85;
    background-color: var(--accent-gold-dim);
    color: var(--text-muted);
}

.button-primary:focus {
    background-color: var(--text-highlight);
    border-color: var(--text-highlight);
}

._01-settings {
    width: 1280px;
    height: 720px;
    flex-shrink: 0;
}

.unity-ui-document__root > ._01-settings {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    width: auto;
    height: auto;
}

