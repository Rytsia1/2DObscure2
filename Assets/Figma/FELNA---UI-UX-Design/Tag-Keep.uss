.tag-keep {
    display: flex;
    padding: 4px 8px;
    align-items: flex-start;
    border-width: 2px;
    background-color: #1D1608;
    flex-direction: row;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    border-color: var(--border-focus);
    color: var(--text-highlight);
}

.tag-keep__e.tag-keep__e.tag-keep__e.tag-keep__e.tag-keep__e.tag-keep__e.tag-keep__e {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-highlight);
}

