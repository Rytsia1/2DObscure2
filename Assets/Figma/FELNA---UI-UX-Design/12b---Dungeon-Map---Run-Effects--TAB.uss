.sprite-iconboss {
    width: 27px;
    height: 27px;
}

.sprite-knight {
    width: 64px;
    height: 80px;
}

.gauge-hp {
    display: flex;
    width: 160px;
    height: 10px;
    padding: 1px 47px 1px 1px;
    align-items: flex-start;
    border-width: 1px;
    overflow: hidden;
    flex-direction: row;
    background-color: var(--bg-void);
    border-color: var(--border-line);
}

.gauge-mp {
    display: flex;
    width: 160px;
    height: 10px;
    padding: 1px 47px 1px 1px;
    align-items: flex-start;
    border-width: 1px;
    overflow: hidden;
    flex-direction: row;
    background-color: var(--bg-void);
    border-color: var(--border-line);
}

.sprite-rogue {
    width: 64px;
    height: 80px;
}

.sprite-mage {
    width: 64px;
    height: 76px;
}

.sprite-healer {
    width: 64px;
    height: 76px;
}

.button-slab {
    display: flex;
    padding: 6px 20px;
    justify-content: center;
    align-items: center;
    border-width: 2px;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    background-color: var(--bg-panel);
    border-color: var(--border-default);
    color: var(--text-primary);
}

.button-slab:disabled {
    opacity: 0.85;
    color: var(--text-muted);
}

.button-slab:focus {
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
    color: var(--text-highlight);
}

