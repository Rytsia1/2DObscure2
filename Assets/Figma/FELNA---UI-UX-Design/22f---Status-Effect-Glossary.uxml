                    <AttributeOverrides element-name="text-5" text="DAMAGE DEALT ×(1 − 30%) · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-25" class="analysis-status-card__i-10" style="flex-shrink: 0; width: 394px;">
