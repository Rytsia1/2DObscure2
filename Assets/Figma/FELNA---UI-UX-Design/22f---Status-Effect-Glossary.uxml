                    <AttributeOverrides element-name="text-3" text="Compelled to act against allies." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="RECORDS CONTROLLER · DEFENSIVE QTE = POOR · REFRESH · 1T" />
                    <AttributeOverrides element-name="text-6" text="⚠ GAP: ACTIONS ARE NOT REDIRECTED YET" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; align-self: stretch; overflow: hidden;">
            <ui:Instance template="Section-Header" class="section-header__i-50" style="flex-shrink: 0; align-self: stretch; height: 40px;">
                <AttributeOverrides element-name="text-0" text="DEBUFFS" />
            </ui:Instance>
            <ui:VisualElement style="display: flex; align-items: flex-start; align-content: flex-start; flex-wrap: wrap; flex-shrink: 0; align-self: stretch; overflow: hidden; flex-direction: row;">
                <ui:Instance template="Analysis-Status-Card-swap-22" class="analysis-status-card__i-15" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="CURSE" />
                    <AttributeOverrides element-name="text-1" text="DEBUFF" />
