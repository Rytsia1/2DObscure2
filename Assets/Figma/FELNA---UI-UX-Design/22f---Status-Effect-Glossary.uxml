                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="35% CHANCE THE ACTION FAILS · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="⚠ GAP: CODE FAILS ACTIONS — NO MP/BUFF BLOCK" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-9" class="analysis-status-card__i-11" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="CONFUSION" />
                    <AttributeOverrides element-name="text-1" text="MENTAL" />
                    <AttributeOverrides element-name="text-2" text="CF" />
                    <AttributeOverrides element-name="text-3" text="Actions target randomly." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
