    <ui:VisualElement class="_22f-status-effect-glossary _22f-status-effect-glossary-vars" style="display: flex; padding: 28px 32px 32px; flex-direction: column; align-items: flex-start; overflow: hidden;">
        <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; align-self: stretch; overflow: hidden;">
            <ui:Label text="STATUS EFFECT GLOSSARY" class="unity-label title-vars-3" style="flex-shrink: 0; font-size: 32px; white-space: nowrap;" />
            <ui:Label text="Dev reference only. The in-game explanation panel stays brief: icon, name, one tag, the one-line description, and ACTIVE / RESIST state for the focused unit (unrevealed tiers stay ???). Descriptions = StatusInfo.Description; IN CODE lines are never shown to players." class="unity-label reference-for-the-analysis-exp-vars" style="flex-shrink: 0; align-self: stretch; font-size: 14px; letter-spacing: 0.56px; white-space: normal;" />
        </ui:VisualElement>
        <ui:VisualElement class="shared-rules-vars" style="display: flex; padding: 12px 16px; align-items: flex-start; flex-shrink: 0; align-self: stretch; border-width: 2px; overflow: hidden; flex-direction: row;">
            <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-grow: 1; flex-shrink: 0; flex-basis: 0px; overflow: hidden;">
                <ui:Label text="DURATION" class="unity-label duration-vars" style="flex-shrink: 0; font-size: 14px; letter-spacing: 0.56px; white-space: nowrap;" />
                <ui:Label text="Counts the bearer's turns; −1 at the start of each of their turns. Default 2T." class="unity-label counts-the-bearer-s-turns-1-vars" style="flex-shrink: 0; align-self: stretch; font-size: 12px; letter-spacing: 0.48px; white-space: normal;" />
            </ui:VisualElement>
            <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-grow: 1; flex-shrink: 0; flex-basis: 0px; overflow: hidden;">
                <ui:Label text="STACKING" class="unity-label stacking-vars" style="flex-shrink: 0; font-size: 14px; letter-spacing: 0.56px; white-space: nowrap;" />
                <ui:Label text="INDEPENDENT: each application is its own timer. REFRESH: keeps the longer duration and bigger magnitude." class="unity-label independent-each-application-vars" style="flex-shrink: 0; align-self: stretch; font-size: 12px; letter-spacing: 0.48px; white-space: normal;" />
            </ui:VisualElement>
            <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-grow: 1; flex-shrink: 0; flex-basis: 0px; overflow: hidden;">
                <ui:Label text="CONTROL" class="unity-label control-vars" style="flex-shrink: 0; font-size: 14px; letter-spacing: 0.56px; white-space: nowrap;" />
                <ui:Label text="Stun, Sleep, Silence, Madness, Mind Control cannot be re-applied while active and give 1T immunity after." class="unity-label stun-sleep-silence-madness-vars" style="flex-shrink: 0; align-self: stretch; font-size: 12px; letter-spacing: 0.48px; white-space: normal;" />
            </ui:VisualElement>
            <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-grow: 1; flex-shrink: 0; flex-basis: 0px; overflow: hidden;">
                <ui:Label text="APPLY CHANCE" class="unity-label apply-chance-vars" style="flex-shrink: 0; font-size: 14px; letter-spacing: 0.56px; white-space: nowrap;" />
                <ui:Label text="P = BASE × (1 − RES). RES = universal + per-status, clamped 0–75%. Bosses ignore all mental effects." class="unity-label p-base-1-res-res-un-vars" style="flex-shrink: 0; align-self: stretch; font-size: 12px; letter-spacing: 0.48px; white-space: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="design-note-code-gaps-vars" style="display: flex; padding: 10px 16px; align-items: center; flex-shrink: 0; align-self: stretch; border-width: 2px; overflow: hidden; flex-direction: row;">
            <ui:Label text="DESIGN NOTE" class="unity-label design-note-vars" style="flex-shrink: 0; font-size: 14px; letter-spacing: 0.56px; white-space: nowrap;" />
            <ui:Label text="Explanations show the intended design. Four effects differ from the code today: FREEZE only slows (no turn skip) · CURSE has no mechanic · MIND CONTROL does not redirect actions · DESPAIR fails actions instead of blocking MP/buffs. Fix the code or the text before shipping the panel." class="unity-label explanations-show-the-intended-vars" style="flex-grow: 1; flex-shrink: 0; flex-basis: 0px; font-size: 12px; letter-spacing: 0.48px; white-space: normal;" />
        </ui:VisualElement>
        <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; align-self: stretch; overflow: hidden;">
            <ui:Instance template="Section-Header" class="section-header__i-47" style="flex-shrink: 0; align-self: stretch; height: 40px;">
                <AttributeOverrides element-name="text-0" text="DAMAGE OVER TIME · TICKS AT BEARER'S TURN START" />
            </ui:Instance>
            <ui:VisualElement style="display: flex; align-items: flex-start; align-content: flex-start; flex-wrap: wrap; flex-shrink: 0; align-self: stretch; overflow: hidden; flex-direction: row;">
                <ui:Instance template="Analysis-Status-Card" class="analysis-status-card__i" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="BURN" />
                    <AttributeOverrides element-name="text-1" text="DOT · DEBUFF · FIRE" />
                    <AttributeOverrides element-name="text-2" text="BN" />
                    <AttributeOverrides element-name="text-3" text="Takes fire damage at turn start." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="15 POWER × CASTER INT ×1.0 · FIRE AFFINITY APPLIES · INDEPENDENT STACKS · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-12" class="analysis-status-card__i-2" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="POISON" />
                    <AttributeOverrides element-name="text-1" text="DOT · DEBUFF · SHADOW" />
                    <AttributeOverrides element-name="text-2" text="PS" />
                    <AttributeOverrides element-name="text-3" text="Takes poison damage at turn start." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="12 POWER × CASTER INT ×0.8 · SHADOW AFFINITY APPLIES · POISONER TALENT BOOSTS · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-26" class="analysis-status-card__i-3" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="BLEED" />
                    <AttributeOverrides element-name="text-1" text="DOT · DEBUFF · PHYSICAL" />
                    <AttributeOverrides element-name="text-2" text="BL" />
                    <AttributeOverrides element-name="text-3" text="Takes bleed damage over time." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="15 POWER × CASTER STR ×1.0 · PHYSICAL · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; align-self: stretch; overflow: hidden;">
            <ui:Instance template="Section-Header" class="section-header__i-48" style="flex-shrink: 0; align-self: stretch; height: 40px;">
                <AttributeOverrides element-name="text-0" text="CONTROL" />
            </ui:Instance>
            <ui:VisualElement style="display: flex; align-items: flex-start; align-content: flex-start; flex-wrap: wrap; flex-shrink: 0; align-self: stretch; overflow: hidden; flex-direction: row;">
                <ui:Instance template="Analysis-Status-Card-swap-6" class="analysis-status-card__i-4" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="STUN" />
                    <AttributeOverrides element-name="text-1" text="CONTROL" />
                    <AttributeOverrides element-name="text-2" text="ST" />
                    <AttributeOverrides element-name="text-3" text="Incapacitated — skips the next turn." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="SKIPS ROUND · DEFENSIVE QTE = POOR · REFRESH · 1T · 1T IMMUNITY AFTER" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-19" class="analysis-status-card__i-5" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="FREEZE" />
                    <AttributeOverrides element-name="text-1" text="CONTROL" />
                    <AttributeOverrides element-name="text-2" text="FZ" />
                    <AttributeOverrides element-name="text-3" text="Frozen solid — cannot act until thawed." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="SPEED ×(1 − 35%) · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="⚠ GAP: CODE ONLY SLOWS — NO TURN SKIP" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-10" class="analysis-status-card__i-6" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="SHOCK" />
                    <AttributeOverrides element-name="text-1" text="CONTROL · LIGHTNING" />
                    <AttributeOverrides element-name="text-2" text="SK" />
                    <AttributeOverrides element-name="text-3" text="Lightning disruption — risk of losing action." />
                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="30% CHANCE THE ACTION FAILS · INDEPENDENT · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="display: flex; flex-direction: column; align-items: flex-start; flex-shrink: 0; align-self: stretch; overflow: hidden;">
            <ui:Instance template="Section-Header" class="section-header__i-49" style="flex-shrink: 0; align-self: stretch; height: 40px;">
                <AttributeOverrides element-name="text-0" text="MENTAL · BOSSES ARE IMMUNE" />
            </ui:Instance>
            <ui:VisualElement style="display: flex; align-items: flex-start; align-content: flex-start; flex-wrap: wrap; flex-shrink: 0; align-self: stretch; overflow: hidden; flex-direction: row;">
                <ui:Instance template="Analysis-Status-Card-swap-15" class="analysis-status-card__i-7" style="flex-shrink: 0; width: 394px;">
