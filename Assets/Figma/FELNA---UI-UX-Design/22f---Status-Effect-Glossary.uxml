                    <AttributeOverrides element-name="text-4" text="IN CODE" />
                    <AttributeOverrides element-name="text-5" text="FORCED BASIC ATTACK ON A RANDOM LIVING UNIT · REFRESH · 2T" />
                    <AttributeOverrides element-name="text-6" text="" />
                </ui:Instance>
                <ui:Instance template="Analysis-Status-Card-swap-17" class="analysis-status-card__i-14" style="flex-shrink: 0; width: 394px;">
                    <AttributeOverrides element-name="text-0" text="MIND CONTROL" />
                    <AttributeOverrides element-name="text-1" text="MENTAL · CONTROL" />
