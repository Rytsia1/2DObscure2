.key-hint {
    display: flex;
    align-items: center;
    flex-direction: row;
}

.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e.key-hint__e {
    display: flex;
    padding: 3px 6px;
    align-items: flex-start;
    flex-shrink: 0;
    border-width: 2px;
    border-color: #8790AD;
    overflow: hidden;
    flex-direction: row;
    background-color: var(--text-body);
}

.key-hint__e-2.key-hint__e-2.key-hint__e-2.key-hint__e-2.key-hint__e-2.key-hint__e-2.key-hint__e-2 {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.48px;
    white-space: nowrap;
    color: var(--text-on-accent);
}

.key-hint__e-3.key-hint__e-3.key-hint__e-3.key-hint__e-3.key-hint__e-3.key-hint__e-3.key-hint__e-3 {
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 0.56px;
    white-space: nowrap;
    color: var(--text-body);
}

