.reward-card-2 {
    display: flex;
    width: 300px;
    height: 380px;
    padding: 16px;
    flex-direction: column;
    align-items: flex-start;
    border-width: 4px;
    background-color: var(--bg-raised);
    border-color: var(--border-accent);
}

.reward-card-2:focus {
    border-width: 2px;
    border-color: var(--border-focus);
}

.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e.reward-card-2__e {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    align-self: stretch;
    overflow: hidden;
    flex-direction: row;
}

.reward-card-2__e-2.reward-card-2__e-2.reward-card-2__e-2.reward-card-2__e-2.reward-card-2__e-2.reward-card-2__e-2.reward-card-2__e-2 {
