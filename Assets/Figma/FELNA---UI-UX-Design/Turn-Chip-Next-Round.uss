.turn-chip-next-round {
    display: flex;
    padding: 4px 8px;
    align-items: center;
    border-width: 2px;
    background-color: #121A31;
    flex-direction: row;
    font-size: 20px;
    white-space: nowrap;
    border-color: var(--border-line);
    color: var(--text-muted);
}

.turn-chip-next-round__e.turn-chip-next-round__e.turn-chip-next-round__e.turn-chip-next-round__e.turn-chip-next-round__e.turn-chip-next-round__e.turn-chip-next-round__e {
    flex-shrink: 0;
    font-size: 20px;
    white-space: nowrap;
    color: var(--text-muted);
}

